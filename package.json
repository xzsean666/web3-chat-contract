{
  "name": "web3-chat-protocol-monorepo",
  "version": "0.1.0",
  "description": "EVM Chat State Storage Protocol Smart Contracts & TypeScript SDK",
  "private": true,
  "author": "xzsean666",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:contracts && pnpm run build:sdk",
    "build:contracts": "hardhat compile && node scripts/sync-artifacts.js",
    "build:sdk": "pnpm --filter @web3-chat/sdk build",
    "test": "pnpm run test:contracts",
    "test:all": "pnpm run test:contracts && pnpm run test:sdk",
    "test:contracts": "hardhat test",
    "test:sdk": "pnpm --filter @web3-chat/sdk test",
    "compile": "hardhat compile",
    "deploy:local": "node scripts/deploy.ts",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.13",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.2",
    "hardhat": "^3.16.0",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "viem": "^2.56.3"
  }
}
